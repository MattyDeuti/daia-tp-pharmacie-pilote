# Maven
target/

# Fichiers compilés
*.class

# IDE
# On ignore le contenu de .vscode/ SAUF mcp.json : la config des accès fait partie
# de la couche du projet, elle doit être versionnée comme le code.
# (Forme obligatoire : `.vscode/*` et non `.vscode/`, sinon git ne peut pas
#  ré-inclure un fichier dont le dossier parent est exclu.)
.vscode/*
!.vscode/mcp.json
.idea/
*.iml

# OS
.DS_Store
Thumbs.db
