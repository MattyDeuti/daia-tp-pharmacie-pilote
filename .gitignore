# Maven
target/

# Fichiers compilés
*.class

# IDE
# On ignore le contenu de .vscode/ SAUF mcp.json et settings.json : la config des
# accès et celle qui fait lire AGENTS.md font partie de la couche du projet, elles
# doivent être versionnées comme le code.
# (Forme obligatoire : `.vscode/*` et non `.vscode/`, sinon git ne peut pas
#  ré-inclure un fichier dont le dossier parent est exclu.)
.vscode/*
!.vscode/mcp.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Sortie du declencheur de demonstration (.github/hooks/journal-agent.*)
# Il se recree tout seul des que le hook est arme ; il n'a rien a faire dans le depot.
journal-agent.txt
